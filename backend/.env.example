# LeadRubyOrbit backend environment example.
# Copy to backend/.env for local development. Never commit real secrets.

# GoHighLevel stays in mock mode unless live sync is explicitly approved.
GHL_MODE=mock
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_WORKFLOW_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# Backend/server settings.
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase settings.
# SUPABASE_SERVICE_ROLE_KEY is backend-only. Never expose it to frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth protection.
# Keep false for local demo mode. Set true in staging/production after frontend login is wired.
AUTH_REQUIRED=false

# Request hardening.
JSON_BODY_LIMIT=1mb
TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=30

# Google OAuth placeholders only. Do not commit real client secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly

# Safe default. Keep mock unless live sending has explicit business approval.
EMAIL_SEND_MODE=mock
EMAIL_SEND_LIVE_APPROVED=false

# Background automation is off by default. Enable only after staging dry-run review.
BACKGROUND_AUTOMATION_ENABLED=false
BACKGROUND_AUTOMATION_RUN_ON_START=false
BACKGROUND_AUTOMATION_INTERVAL_MS=900000
BACKGROUND_AUTOMATION_CAMPAIGN_BATCH_SIZE=25
BACKGROUND_AUTOMATION_NO_REPLY_TIMEOUT_DAYS=3
BACKGROUND_AUTOMATION_CREATE_FOLLOWUP_DRAFTS=true
BACKGROUND_AUTOMATION_FOLLOWUP_DRAFT_BATCH_SIZE=25
